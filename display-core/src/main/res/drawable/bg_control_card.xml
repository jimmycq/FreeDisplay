<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Specular rim -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="270"
                android:startColor="#54FFFFFF"
                android:centerColor="#24FFFFFF"
                android:endColor="#12FFFFFF" />
        </shape>
    </item>
    <!-- Frosted glass floating control bar -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="21dp" />
            <gradient
                android:angle="270"
                android:startColor="#C4152036"
                android:endColor="#B50D1524" />
            <padding
                android:bottom="5dp"
                android:left="7dp"
                android:right="7dp"
                android:top="5dp" />
        </shape>
    </item>
</layer-list>
