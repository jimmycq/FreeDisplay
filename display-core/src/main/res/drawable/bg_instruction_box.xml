<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle specular border for glass section cards -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="#42FFFFFF"
                android:centerColor="#1EFFFFFF"
                android:endColor="#12FFFFFF" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <solid android:color="#6E152036" />
            <padding
                android:bottom="12dp"
                android:left="14dp"
                android:right="14dp"
                android:top="12dp" />
        </shape>
    </item>
</layer-list>
