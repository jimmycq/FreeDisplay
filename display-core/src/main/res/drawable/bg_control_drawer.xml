<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dynamic-Island style specular rim -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="270"
                android:startColor="#5CFFFFFF"
                android:endColor="#18FFFFFF" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="#C8121B2E" />
            <padding
                android:bottom="6dp"
                android:left="16dp"
                android:right="16dp"
                android:top="6dp" />
        </shape>
    </item>
</layer-list>
