<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dialog specular rim -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="270"
                android:startColor="#5CFFFFFF"
                android:centerColor="#29FFFFFF"
                android:endColor="#14FFFFFF" />
        </shape>
    </item>
    <!-- High-opacity dark frosted glass -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="23dp" />
            <gradient
                android:angle="270"
                android:startColor="#EB172338"
                android:endColor="#E60E1626" />
        </shape>
    </item>
</layer-list>
